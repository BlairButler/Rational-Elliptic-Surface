load "AutSplit.m";

// ---------------------------------------------------------------------------
// y^2 = x^3 + t^5 + t^-5
//
// We are going to consider the Rank 16 K3 elliptic surface given above.
// We will look at a quadratic twist, giving us the rank 8 rational elliptic surfacey^2 = x^3 + (t^5-5*t^3-5*t)
// We can then run algorithm 2 on this.
// The information from this can then be 'lifted' back up to y^2 = x^3 + t^5 + t^-5
// The other 8 independent sections can be found and verified easily.
// We then look at the Galois action on the coefficients of the sections to determine the representations
// ---------------------------------------------------------------------------

// lemma_4_2.magma
//
// Computes the proof of Lemma 4.2:
//   The K3 elliptic surface y^2 = x^3 + t^5 + t^{-5} has rank 16,
//   and its field of definition is a number field of degree 192.
//
// Strategy (following the proof):
//   1-5. PrimaryDecompose section ideal of y^2 = x^3 + (t^5-5t^3+5t); call
//        SplitAutGrp on per-component univariates + Phi_5 to build N; recover
//        240 sections via per-component BackSubAll (RatESSolve pattern).
//   6.   Apply t -> zeta_5^k * t for k=0..4 to lift to 1200 K3 sections.
//   7.   Reduce mod p = 133773121; build E_K3 over GF(p)(T).
//   8.   IndependentGenerators -> rank 16.
//   9.   Galois representation: Gal(N/Q) -> GL_16(Q), decompose, check faithfulness.
//
// Output: rank, N, Gal(N/Q), 16 generator sections, torsion, IrrReps, Characters

load "AutSplit.m";

printf "=== Lemma 4.2: K3 surface y^2 = x^3 + t^5 + t^{-5} ===\n\n";

// -----------------------------------------------------------------------
// Steps 1-5: Section ideal, primary decomposition, SplitAutGrp (with Phi_5
//   appended), and per-component BackSubAll — following RatESSolve exactly.
//   PD gives staircase-structured per-component GBs: non-univariate elements
//   are linear in their leading variable, so BackSubAll is pure linear
//   arithmetic (no Roots() calls over a high-degree field).
// -----------------------------------------------------------------------
k := RationalField();
Qx<x_var> := PolynomialRing(k);
R7<s1,s2,s3,s4,s5,s6,s7> := PolynomialRing(k, 7, "lex");
Rt<tt> := PolynomialRing(R7);

X_sec  := s1*tt^2 + s2*tt + s3;
Y_sec  := s4*tt^3 + s5*tt^2 + s6*tt + s7;
a6_rat := tt^5 - 5*tt^3 + 5*tt;
WEq    := Y_sec^2 - X_sec^3 - a6_rat;

I := ideal<R7 | Coefficients(WEq)>;
printf "Steps 1-3: Primary decomposition of section ideal...\n";
PD_all   := PrimaryDecomposition(I);
non_triv := [Q : Q in PD_all | Dimension(Q) eq 0];
printf "Steps 1-3: %o non-trivial component(s).\n", #non_triv;

// Per-component data (RatESSolve pattern)
comp_data     := [];   // <poly, GB, uni_var, rat_roots>
seen_polys    := [];   // unique irred Q-factors of component univariates
comp_for_poly := [];   // comp_data index for each entry of seen_polys
extra_seen    := [];   // extra univariates from non-linear GB elements

for Q in non_triv do
    GB := GroebnerBasis(Q);
    uni := false; deg_uni := 0; uni_var := 0;
    for g in GB do
        vars_used := {};
        for m in Monomials(g) do
            ev := Exponents(m);
            for i in [1..7] do if ev[i] ne 0 then Include(~vars_used, i); end if; end for;
        end for;
        if #vars_used eq 1 and Degree(g) gt deg_uni then
            uni := g; deg_uni := Degree(g); uni_var := Rep(vars_used);
        end if;
    end for;
    if uni cmpeq false then continue; end if;

    cf   := [MonomialCoefficient(uni, R7.uni_var^i) : i in [0..deg_uni]];
    poly := Polynomial(RationalField(), [RationalField()!c : c in cf]);
    poly := poly div GCD(poly, Derivative(poly));

    // Extra univariates from non-linear non-univariate GB elements
    for g in GB do
        lv_g     := Min([i : i in [1..7] | Exponents(LeadingMonomial(g))[i] ne 0]);
        if lv_g eq uni_var then continue; end if;
        deg_g_lv := Max([Exponents(m)[lv_g] : m in Monomials(g)]);
        if deg_g_lv le 1 then continue; end if;
        res := Resultant(g, uni, R7.uni_var);
        if IsZero(res) then continue; end if;
        vars_res := {};
        for m in Monomials(res) do
            ev := Exponents(m);
            for i in [1..7] do if ev[i] ne 0 then Include(~vars_res, i); end if; end for;
        end for;
        if not (#vars_res eq 1 and lv_g in vars_res) then continue; end if;
        deg_res := Max([Exponents(m)[lv_g] : m in Monomials(res)]);
        cf_res  := [MonomialCoefficient(res, R7.lv_g^d) : d in [0..deg_res]];
        ep := Polynomial(RationalField(), [RationalField()!c : c in cf_res]);
        ep := ep div GCD(ep, Derivative(ep));
        for ep_fac in Factorization(ep) do
            ep_f := ep_fac[1];
            if Degree(ep_f) ge 2 and not exists{p : p in extra_seen | p eq ep_f} then
                Append(~extra_seen, ep_f);
            end if;
        end for;
    end for;

    cd_idx := #comp_data + 1;
    rat_roots_comp := [RationalField() | ];
    for fac in Factorization(poly) do
        f := fac[1];
        if Degree(f) eq 1 then
            Append(~rat_roots_comp, -Coefficient(f, 0) / Coefficient(f, 1));
        elif not exists{p : p in seen_polys | p eq f} then
            Append(~seen_polys, f);
            Append(~comp_for_poly, cd_idx);
        end if;
    end for;
    Append(~comp_data, <poly, GB, uni_var, rat_roots_comp>);
end for;
printf "Steps 1-3: %o section univariate(s), %o extra polynomial(s).\n",
    #seen_polys, #extra_seen;

// SplitAutGrp on section polys only — NO Phi_5 yet.
// This matches RatESSolve exactly: BackSubAll runs over the smaller K_rat
// (splitting field of the section variety alone), not the full field_N.
// Roots() calls inside BackSubAll hit roots already in K_rat → fast.
Phi5     := x_var^4 + x_var^3 + x_var^2 + x_var + 1;
_sp_base := seen_polys cat extra_seen;
_sp_prod := &*_sp_base;
if not IsSquarefree(_sp_prod) then
    _sp_sf   := _sp_prod div GCD(_sp_prod, Derivative(_sp_prod));
    _sp_base := [fac[1] : fac in Factorization(_sp_sf) | Degree(fac[1]) ge 2];
end if;

printf "\nSteps 1-3: Calling SplitAutGrp on %o section polynomial(s)...\n", #_sp_base;
K_rat, aut_rat, map_rat, _rll_rat := SplitAutGrp(_sp_base : Prime := NextPrime(10^6));
printf "Steps 1-3: [K_rat:Q] = %o, |Gal| = %o.\n", Degree(K_rat), #aut_rat;
_root_ll := _rll_rat[1..#seen_polys];

// -----------------------------------------------------------------------
// Steps 4-5: Per-component BackSubAll over K_rat (RatESSolve pattern).
//   K_rat is the splitting field of the section variety — all roots of every
//   non-univariate GB element are already in K_rat, so Roots() calls are cheap.
// -----------------------------------------------------------------------
printf "\nSteps 4-5: Building sections via per-component BackSubAll over K_rat...\n";

function BackSubAll(sv_init, non_uni, K)
    KT<T_bs> := PolynomialRing(K);
    svs := [sv_init];
    for pair in non_uni do
        lv   := pair[1]; g := pair[2]; mons := Monomials(g);
        new_svs := [];
        for sv in svs do
            h := KT!0;
            for m in mons do
                ev    := Exponents(m);
                c     := K!MonomialCoefficient(g, m);
                other := K!1;
                for j in [lv+1..7] do
                    if ev[j] ne 0 then other *:= sv[j]^ev[j]; end if;
                end for;
                h +:= c * other * T_bs^ev[lv];
            end for;
            if IsZero(h) then Append(~new_svs, sv); continue; end if;
            d := Degree(h);
            if d le 1 then
                c1 := Coefficient(h,1); c0 := Coefficient(h,0);
                if not IsWeaklyZero(c1) then
                    sv_new := sv; sv_new[lv] := -c0/c1;
                    Append(~new_svs, sv_new);
                else
                    Append(~new_svs, sv);
                end if;
            else
                for rt in Roots(h, K) do
                    sv_new := sv; sv_new[lv] := rt[1];
                    Append(~new_svs, sv_new);
                end for;
            end if;
        end for;
        svs := new_svs;
    end for;
    return svs;
end function;

function MakeNonUni(GB_c, uv)
    non_uni := [];
    for g in GB_c do
        lv := Min([j : j in [1..7] | Exponents(LeadingMonomial(g))[j] ne 0]);
        if lv ne uv then Append(~non_uni, <lv, g>); end if;
    end for;
    Sort(~non_uni, func<a, b | b[1] - a[1]>);
    return non_uni;
end function;

Sections_Krat := [];
for i in [1..#seen_polys] do
    cd := comp_data[comp_for_poly[i]];
    non_uni := MakeNonUni(cd[2], cd[3]);
    for root in _root_ll[i] do
        sv_init := [K_rat!0 : j in [1..7]]; sv_init[cd[3]] := root;
        for sv in BackSubAll(sv_init, non_uni, K_rat) do
            Append(~Sections_Krat, sv);
        end for;
    end for;
end for;
for cd in comp_data do
    if #cd[4] eq 0 then continue; end if;
    non_uni := MakeNonUni(cd[2], cd[3]);
    for root in cd[4] do
        sv_init := [K_rat!0 : j in [1..7]]; sv_init[cd[3]] := K_rat!root;
        for sv in BackSubAll(sv_init, non_uni, K_rat) do
            Append(~Sections_Krat, sv);
        end for;
    end for;
end for;
printf "Steps 4-5: %o sections found over K_rat.\n", #Sections_Krat;

// -----------------------------------------------------------------------
// Adjoin zeta_5 if not already in K_rat to get field_N for Steps 6-9.
// -----------------------------------------------------------------------
_PK<_xK> := PolynomialRing(K_rat);
_z5_rts   := Roots(_xK^4 + _xK^3 + _xK^2 + _xK + 1);
if #_z5_rts gt 0 then
    // K_rat already contains zeta_5 — no extension needed
    field_N   := K_rat;
    aut_N     := aut_rat;
    aut_map_N := map_rat;
    zeta5     := _z5_rts[1][1];
    Sections_N := Sections_Krat;
    printf "Steps 1-3: zeta5 already in K_rat; field_N = K_rat.\n";
else
    // Extend: call SplitAutGrp with Phi_5 appended
    printf "\nSteps 1-3: Adjoining zeta_5 (not in K_rat); calling SplitAutGrp with Phi_5...\n";
    _sp_full := _sp_base cat [Phi5];
    field_N, aut_N, aut_map_N, _rll_N := SplitAutGrp(_sp_full : Prime := NextPrime(10^6));
    printf "Steps 1-3: [field_N:Q] = %o, |Gal(N/Q)| = %o.\n", Degree(field_N), #aut_N;
    // zeta5 is the last root_ll entry (Phi5 appended last)
    zeta5 := _rll_N[#_rll_N][1];
    // Re-run BackSubAll directly over field_N using _rll_N.
    // Avoids Roots(DefPoly(K_rat), field_N) which is a degree-[K_rat:Q]
    // polynomial factorization over a degree-192 field — too slow.
    // With extra_seen in _sp_full, field_N contains all roots, so any
    // Roots() call inside BackSubAll resolves trivially.
    _root_ll_N := _rll_N[1..#seen_polys];
    Sections_N := [];
    for i in [1..#seen_polys] do
        cd := comp_data[comp_for_poly[i]];
        non_uni := MakeNonUni(cd[2], cd[3]);
        for root in _root_ll_N[i] do
            sv_init := [field_N!0 : j in [1..7]]; sv_init[cd[3]] := root;
            for sv in BackSubAll(sv_init, non_uni, field_N) do
                Append(~Sections_N, sv);
            end for;
        end for;
    end for;
    for cd in comp_data do
        if #cd[4] eq 0 then continue; end if;
        non_uni := MakeNonUni(cd[2], cd[3]);
        for root in cd[4] do
            sv_init := [field_N!0 : j in [1..7]]; sv_init[cd[3]] := field_N!root;
            for sv in BackSubAll(sv_init, non_uni, field_N) do
                Append(~Sections_N, sv);
            end for;
        end for;
    end for;
end if;
assert zeta5^5 eq field_N!1 and zeta5 ne field_N!1;
printf "Steps 1-3: zeta5 confirmed (min poly degree %o). ✓\n", Degree(MinimalPolynomial(zeta5));
printf "Steps 4-5: %o sections of rational surface found over N.\n", #Sections_N;

// -----------------------------------------------------------------------
// Step 6: Lift to 1200 K3 sections via t -> zeta_5^k * t  (k = 0..4)
//   K3 surface: y^2 = x^3 + t^5 + t^{-5}
//   Sections have form x = sv[1]*u^2 + sv[2]*u + sv[3],
//                      y = sv[4]*u^3 + sv[5]*u^2 + sv[6]*u + sv[7],
//   where u = zeta_5^k * t + zeta_5^{-k} / t  (the k-th twist of t + t^{-1})
// -----------------------------------------------------------------------
printf "\nStep 6: %o rational sections x 5 twists = %o K3 sections.\n",
    #Sections_N, 5 * #Sections_N;

// Store each K3 section as <k_twist, sv> for later Galois action
K3_data := [];    // sequence of <k_twist (0..4), [s1..s7] in N>
for k_tw in [0..4] do
    for sv in Sections_N do
        Append(~K3_data, <k_tw, sv>);
    end for;
end for;

// -----------------------------------------------------------------------
// Step 7: Reduction mod p = 133773121
// -----------------------------------------------------------------------
p := 133773121;
printf "\nStep 7: Reducing mod p = %o.\n", p;
assert IsPrime(p);
assert (p-1) mod 5 eq 0;
printf "Step 7: p prime, p ≡ 1 mod 5. ✓\n";

Npol_Z := PolynomialRing(Integers())!DefiningPolynomial(field_N);
facs_N_modp := Factorization(ChangeRing(Npol_Z, GF(p)));
assert forall{fac : fac in facs_N_modp | Degree(fac[1]) eq 1};
printf "Step 7: N splits completely at p. ✓\n";

Fp     := GF(p);
a_root := -Coefficient(facs_N_modp[1][1], 0);   // a root of DefPoly(N) in GF(p)

function red_N(c)
    coords := Eltseq(c);
    return Evaluate(
        Polynomial(Fp, [Fp!Numerator(r) * (Fp!Denominator(r))^(-1) : r in coords]),
        a_root);
end function;

FFp    := FunctionField(Fp);
Tp     := FFp.1;
E_K3_p := EllipticCurve([FFp!0, FFp!0, FFp!0, FFp!0, Tp^5 + Tp^(-5)]);

zeta5_p := red_N(zeta5);
assert zeta5_p^5 eq Fp!1 and zeta5_p ne Fp!1;
printf "Step 7: zeta5 mod p = %o (order 5 in GF(p)). ✓\n", zeta5_p;

// Reduce one K3 section to E_K3_p
function K3_red(k_tw, sv)
    u  := zeta5_p^k_tw * Tp + zeta5_p^(-k_tw) / Tp;
    s  := [red_N(sv[ii]) : ii in [1..7]];
    xr := s[1]*u^2 + s[2]*u + s[3];
    yr := s[4]*u^3 + s[5]*u^2 + s[6]*u + s[7];
    return E_K3_p![xr, yr];
end function;

printf "Step 7: Computing 1200 reduced K3 points...";
pts_K3_p := [];
for ii in [1..#K3_data] do
    if ii mod 200 eq 0 then printf " %o", ii; end if;
    d := K3_data[ii];
    Append(~pts_K3_p, K3_red(d[1], d[2]));
end for;
printf "\nStep 7: Done.\n";

// -----------------------------------------------------------------------
// Step 8: Torsion detection and IndependentGenerators -> rank 16
// -----------------------------------------------------------------------
printf "\nStep 8: Finding generators...\n";
TorsIdxs := {};
for ii in [1..#pts_K3_p] do
    if HeightPairing(pts_K3_p[ii], pts_K3_p[ii]) eq 0 then
        Include(~TorsIdxs, ii);
    end if;
end for;
NonTorsIdxs := [ii : ii in [1..#K3_data] | ii notin TorsIdxs];
printf "Step 8: %o torsion, %o non-torsion.\n", #TorsIdxs, #NonTorsIdxs;

NonTorsPts_p := [pts_K3_p[ii] : ii in NonTorsIdxs];
IndPts := IndependentGenerators(NonTorsPts_p);
GenPts_p := [];
GenData  := [];    // <k_twist, sv> for each of the r generators
for pt in IndPts do
    idx := Index(NonTorsPts_p, pt);
    if idx gt 0 then
        Append(~GenPts_p, pt);
        Append(~GenData,  K3_data[NonTorsIdxs[idx]]);
    end if;
end for;
r_K3 := #GenPts_p;
printf "Step 8: Rank = %o.\n", r_K3;

// -----------------------------------------------------------------------
// Step 9: Galois representation Gal(N/Q) -> GL_r(Q)
//   sigma acts on K3 section (k_tw, sv) as:
//     (k_tw, sv) -> (k_tw * j mod 5, (phi(sv[1]),...,phi(sv[7])))
//   where phi = aut_map_N(sigma) and sigma(zeta5) = zeta5^j.
// -----------------------------------------------------------------------
printf "\nStep 9: Building Galois representation...\n";

GramMat := Matrix(Rationals(), r_K3, r_K3,
    [HeightPairing(GenPts_p[ii], GenPts_p[jj]) : ii in [1..r_K3], jj in [1..r_K3]]);
GramInv := GramMat^(-1);

// Determine j: sigma(zeta5) = zeta5^j
function twist_order(phi)
    z  := phi(zeta5);
    zp := field_N!1;
    for jj in [1..5] do
        zp *:= zeta5;
        if zp eq z then return jj; end if;
    end for;
    error "twist_order: could not determine j";
end function;

aut_mats := [];
for sigma in Generators(aut_N) do
    phi   := aut_map_N(sigma);
    j_ord := twist_order(phi);
    rows  := [];
    for ii in [1..r_K3] do
        gd     := GenData[ii];
        k_new  := (gd[1] * j_ord) mod 5;
        sv_new := [phi(gd[2][mm]) : mm in [1..7]];
        pt_sig := K3_red(k_new, sv_new);
        v      := Vector(Rationals(), [HeightPairing(pt_sig, GenPts_p[jj]) : jj in [1..r_K3]]);
        a_vec  := v * GramInv;
        Append(~rows, [Round(a_vec[jj]) : jj in [1..r_K3]]);
    end for;
    Append(~aut_mats, Matrix(Integers(), rows));
end for;

IrrReps := []; Chars := []; kern_order := -1;
if #aut_mats gt 0 and r_K3 gt 0 then
    GP_K3   := MatrixGroup<r_K3, Rationals() | [ChangeRing(m, Rationals()) : m in aut_mats]>;
    Gmod_K3 := GModule(GP_K3);
    IC      := ConstituentsWithMultiplicities(Gmod_K3);
    IrrReps := IC;
    CT      := RationalCharacterTable(GP_K3);
    Chars   := [CT[ii] : ii in [1..#CT]
               | exists{pair : pair in IC | Character(pair[1]) eq CT[ii]}];
    kern_order := #aut_N div #GP_K3;
    printf "Step 9: Image of representation has order %o.\n", #GP_K3;
    printf "Step 9: |kernel| = %o (%o).\n", kern_order,
        kern_order eq 1 select "FAITHFUL" else "NOT FAITHFUL";
end if;
printf "Step 9: %o irreducible constituent(s).\n", #IrrReps;

// -----------------------------------------------------------------------
// Output
// -----------------------------------------------------------------------
printf "\n";
printf "======================================================\n";
printf "RESULTS — Lemma 4.2\n";
printf "======================================================\n";
printf "1.  Rank of K3 surface over N(t):   %o\n", r_K3;
printf "2.  Field of definition N:\n";
printf "      [N:Q] = %o\n", Degree(field_N);
printf "      Defining polynomial: %o\n", DefiningPolynomial(field_N);
printf "3.  Galois group Gal(N/Q):\n";
printf "      Order = %o\n", #aut_N;
printf "4.  Generator sections (as (twist_k, [s1..s7])):\n";
for ii in [1..r_K3] do
    gd := GenData[ii];
    printf "      Gen %o: twist k=%o, coeffs [s1,s2,s3] = [%o, %o, %o]\n",
        ii, gd[1], gd[2][1], gd[2][2], gd[2][3];
end for;
printf "5.  Torsion sections: %o\n", #TorsIdxs;
printf "6.  Irreducible constituents of Galois representation:\n";
for ii in [1..#IrrReps] do
    printf "      Constituent %o: dimension %o, multiplicity %o\n",
        ii, Dimension(IrrReps[ii][1]), IrrReps[ii][2];
end for;
printf "7.  Characters:\n";
for ii in [1..#Chars] do
    printf "      %o\n", Chars[ii];
end for;
if kern_order ge 0 then
    printf "Faithfulness: representation is %o => N is %o the true field of definition.\n",
        kern_order eq 1 select "FAITHFUL" else "NOT FAITHFUL",
        kern_order eq 1 select "confirmed as" else "NOT";
end if;
printf "======================================================\n";

