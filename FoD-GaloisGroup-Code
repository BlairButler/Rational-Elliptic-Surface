\\Polynomials from all of the elliptic surfaces, to find the degree of the field of definition for y^2 = x^3 + t^360 + 1.
\\All 11 polynomials together give a polynomial of degree 829,440

Rx<x>:=PolynomialRing(Integers());
fl:=[x^2 - x + 1,
x^8 - 6*x^4 - 3,
x^6 - 3*x^5 + 5*x^3 - 3*x + 1,
x^9 + 6*x^3 - 2,
x^8 - x^7 + 2*x^6 + 2*x^5 - 5*x^4 + 13*x^3 - 13*x^2 + x + 1,
x^5 - x^4 + 4*x^3 + 4*x^2 - x + 13,
x^3 - x^2 - 3*x - 3,
x^12 - 4*x^9 + 22*x^6 - 12*x^3 + 2,
x^12 + 4*x^6 + 54,
x^16-60*x^12-370*x^8-300*x^4+25,
x^4-x^3+x^2-x+1,
x^4-2*x^3+4*x^2+12*x+6,
x^3-5];
f:=&*fl;
time G,r,S:=GaloisGroup(&*fl);
#G;

time GaloisProof(f,S);
